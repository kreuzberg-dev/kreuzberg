def self.verify_excerpt: (String excerpt, String source_text) -> bool

    interface _OcrBackend
        # Optional methods the bridge calls when the object defines them (the
        # trait's Rust default behavior applies otherwise): process_image_file, supported_languages, supports_table_detection, supports_document_processing, emits_structured_markdown, confidence_semantics, page_orientation_handling, process_document.
        # The lifecycle hooks `initialize`/`shutdown` are likewise optional (note:
        # Ruby constructors are private and never count as the lifecycle hook).
    def process_image: (String image_bytes, OcrConfig config) -> ExtractedDocument
    def supports_language: (String lang) -> bool
    def backend_type: () -> OcrBackendType
    end

    interface _PostProcessor
        # Optional methods the bridge calls when the object defines them (the
        # trait's Rust default behavior applies otherwise): should_process, estimated_duration_ms, priority.
        # The lifecycle hooks `initialize`/`shutdown` are likewise optional (note:
        # Ruby constructors are private and never count as the lifecycle hook).
    def process: (ExtractedDocument result, ExtractionConfig config) -> void
    def processing_stage: () -> ProcessingStage
    end

    interface _Validator
        # Optional methods the bridge calls when the object defines them (the
        # trait's Rust default behavior applies otherwise): should_validate, priority.
        # The lifecycle hooks `initialize`/`shutdown` are likewise optional (note:
        # Ruby constructors are private and never count as the lifecycle hook).
    def validate: (ExtractedDocument result, ExtractionConfig config) -> void
    end

    interface _DocumentExtractor
        # Optional methods the bridge calls when the object defines them (the
        # trait's Rust default behavior applies otherwise): priority, can_handle.
        # The lifecycle hooks `initialize`/`shutdown` are likewise optional (note:
        # Ruby constructors are private and never count as the lifecycle hook).
    def extract: (ExtractInput input, ExtractionConfig config) -> ExtractedDocument
def supported_mime_types: () -> Array[String]
    end

    interface _EmbeddingBackend
    def dimensions: () -> Integer
def embed: (Array[String] texts) -> Array[Array[Float]]
    end

    interface _Renderer
        # Optional methods the bridge calls when the object defines them (the
        # trait's Rust default behavior applies otherwise): render_result.
        # The lifecycle hooks `initialize`/`shutdown` are likewise optional (note:
        # Ruby constructors are private and never count as the lifecycle hook).
    end

    interface _RerankerBackend
def rerank: (String query, Array[String] documents) -> Array[Float]
    end

    interface _TokenizerBackend
    def count_tokens: (String text) -> Integer
    end

def self.register_ocr_backend: (_OcrBackend backend, String name) -> nil

def self.unregister_ocr_backend: (String name) -> nil

def self.register_post_processor: (_PostProcessor backend, String name) -> nil

def self.unregister_post_processor: (String name) -> nil

def self.register_validator: (_Validator backend, String name) -> nil

def self.unregister_validator: (String name) -> nil

def self.register_embedding_backend: (_EmbeddingBackend backend, String name) -> nil

def self.unregister_embedding_backend: (String name) -> nil

def self.register_reranker_backend: (_RerankerBackend backend, String name) -> nil

def self.unregister_reranker_backend: (String name) -> nil

def self.register_tokenizer_backend: (_TokenizerBackend backend, String name) -> nil

def self.unregister_tokenizer_backend: (String name) -> nil

